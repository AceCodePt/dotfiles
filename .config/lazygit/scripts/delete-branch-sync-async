#!/bin/bash
# delete-branch-sync-async - Delete branch+worktree sync, hooks async
# Usage: delete-branch-sync-async <branch-name>

BRANCH_NAME="$1"

if [ -z "$BRANCH_NAME" ]; then
  echo "Error: Branch name required"
  exit 1
fi

echo "🗑️  Deleting branch: $BRANCH_NAME"

# Find worktree
WORKTREE_PATH=$(git worktree list | grep "\[$BRANCH_NAME\]" | awk '{print $1}' || echo "")

GIT_COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
PROJECT_ROOT=""
if [ -n "$GIT_COMMON_DIR" ]; then
  case "$(basename "$GIT_COMMON_DIR")" in
    *.git) PROJECT_ROOT="$GIT_COMMON_DIR" ;;
    .git)  PROJECT_ROOT="$(dirname "$GIT_COMMON_DIR")" ;;
    *)     PROJECT_ROOT="$GIT_COMMON_DIR" ;;
  esac
fi

# Sync: Remove worktree
if [ -n "$WORKTREE_PATH" ] && [ -d "$WORKTREE_PATH" ]; then
  echo "📁 Removing worktree..."
  git worktree remove "$WORKTREE_PATH" --force 2>/dev/null || rm -rf "$WORKTREE_PATH"
  echo "✅ Worktree removed"
fi

# Sync: Delete branch
if git branch -D "$BRANCH_NAME" 2>/dev/null; then
  echo "✅ Branch deleted"
else
  echo "❌ Failed to delete branch"
  exit 1
fi

# Async: Run hooks in background (output streams to lazygit)
(
  export BRANCH_NAME="$BRANCH_NAME"
  export WORKTREE_PATH="$WORKTREE_PATH"
  if [ -n "$PROJECT_ROOT" ]; then
    PRE_HOOK="$PROJECT_ROOT/hooks/pre-branch-delete"
    POST_HOOK="$PROJECT_ROOT/hooks/post-branch-delete"
    [ -x "$PRE_HOOK" ] && bash "$PRE_HOOK"
    [ -x "$POST_HOOK" ] && bash "$POST_HOOK"
  else
    echo "PROJECT_ROOT not resolved, hooks skipped"
  fi
) & disown

echo "✅ Complete!"
