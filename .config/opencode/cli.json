{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "session.parent": "up",
    "session.page.up": "none",
    "session.page.down": "none",
    "session.half.page.up": "pgup,shift+up",
    "session.half.page.down": "pgdown,shift+down",
    "agent.cycle": "tab"
  },
  "diffs": {
    "wrap": "word",
    "view": "unified"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "tabs": {
    "mode": "off",
    "scope": "cwd"
  }
}
