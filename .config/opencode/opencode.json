{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": false,
  "lsp": true,
  "plugin": [
    "@ex-machina/opencode-anthropic-auth"
  ],
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    }
  },
  "experimental": {
    "batch_tool": false
  },
  "permission": {
    "edit": {
      "**/.orchestration/**": "deny",
      "$HOME/.config/opencode/opencode.json": "deny"
    },
    "skill": {
      "ask-matt": "deny",
      "claude-handoff": "deny",
      "grill-me": "deny",
      "grill-with-docs": "deny",
      "handoff": "deny",
      "implement": "deny",
      "improve-codebase-architecture": "deny",
      "loop-me": "deny",
      "setup-ts-deep-modules": "deny",
      "teach": "deny",
      "to-questionnaire": "deny",
      "triage": "deny",
      "wait-what": "deny",
      "wayfinder": "deny",
      "writing-beats": "deny",
      "writing-fragments": "deny",
      "writing-shape": "deny"
    }
  }
}
