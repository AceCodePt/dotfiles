{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash",
  "theme": "system",
  "autoupdate": false,
  "lsp": true,
  "snapshot": false,
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/*.git/**",
      "**/dist/**",
      "**/build/**"
    ]
  },
  "experimental": {
    "batch_tool": false
  },
  "permission": {
    "edit": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/**": "allow",
      "**/.orchestration/**": "deny",
      "$HOME/.config/opencode/opencode.json": "deny"
    },
    "question": "deny",
    "skill": {
      "ask-matt": "deny",
      "claude-handoff": "deny",
      "grill-me": "deny",
      "grill-with-docs": "deny",
      "handoff": "deny",
      "implement": "deny",
      "improve-codebase-architecture": "deny",
      "loop-me": "deny",
      "setup-ts-deep-modules": "deny",
      "teach": "deny",
      "to-questionnaire": "deny",
      "triage": "deny",
      "wait-what": "deny",
      "wayfinder": "deny",
      "writing-beats": "deny",
      "writing-fragments": "deny",
      "writing-shape": "deny"
    }
  }
}
